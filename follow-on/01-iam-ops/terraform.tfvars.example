# Copy to terraform.tfvars and fill in.

# Change History
# 2026-10-07 Steve Hager - v1.0 Initial version
# 2026-10-07 Steve Hager - v1.1 corrected SA name to be consistent with the bootstrap project.
# 2026-10-07 Steve Hager - v1.2 made references to bootstrap-project-id consistent with other files.

common_folder_id      = "folders/000000000000"
billing_account_id    = "XXXXXX-XXXXXX-XXXXXX"
workspace_customer_id = "C00000000"

# Project ID = [org_prefix-]project_id_base[-suffix]  ->  shv-common-identity
org_prefix        = "shv"
project_id_base   = "common-identity"
project_id_suffix = ""        # "" = none, "random" = 4 hex chars, or a literal like "01"

# PREVENT (default) | DELETE | ABANDON. Switching is in-place; the project is never recreated.
project_deletion_policy = "PREVENT"

# Usually your bootstrap project ID, so user-ADC API calls have a quota project.
# Leave unset if impersonating with an SA.  The SA's own project handles quota.
#quota_project = "bootstrap-project-id"

# Run as the bootstrap Terraform SA instead of your own ADC.
terraform_impersonate_sa = "terraform-super-admin@<bootstrap-project-id>.iam.gserviceaccount.com"

impersonators = [
  "user:admin@stevenhager.com",
]

# Set false if you'd rather assign the Workspace roles in the Admin console.
assign_workspace_roles = true
